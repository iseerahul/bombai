# Read by `docker compose`, NOT by the app.
#
#   cp .env.example .env
#
# Copy this to `.env` and fill it in before `docker compose up`. These values
# are passed into the container as environment variables; nothing here is baked
# into the image, and `.env` is gitignored.
#
# For local development WITHOUT Docker, this file is not used at all — the dev
# server reads `.dev.vars` instead. See .dev.vars.example.

# Salts the rate-limit hash. Any long random string; changing it just resets
# the buckets, which is harmless.
#   openssl rand -hex 32
IP_SALT=

# Where the browser reaches the container. Google builds its OAuth redirect
# from this, so it must match both the URL you open and the Authorised redirect
# URI in Google Cloud — otherwise sign-in fails with redirect_uri_mismatch.
# Behind a reverse proxy this is your public https:// URL, not localhost.
APP_ORIGIN=http://localhost:8787

# ONLY for docker-compose.https.yml. The hostname Caddy gets a certificate
# for. With no domain of your own, sslip.io turns any IP into a real
# hostname — 13.203.232.95.sslip.io resolves to 13.203.232.95 — which is
# what lets Let's Encrypt issue, since no CA issues for a bare IP.
# Set APP_ORIGIN to https://<the same hostname> when you use it.
SITE_ADDRESS=

# ONLY for docker-compose.nginx.yml. Let's Encrypt emails certificate-expiry
# warnings here — which is the one thing that tells you renewal has silently
# stopped working before the site goes down.
LETSENCRYPT_EMAIL=

# Optional. Leave both blank and the Worker falls back to its local dev login,
# which is fine for a demo on your own machine and unsafe on anything reachable
# from outside. Credentials: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI:    <APP_ORIGIN>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Walking, cycling and driving directions. Free, no card:
#   https://openrouteservice.org/dev/#/signup
# Leave it blank and routing does NOT error — it falls back to straight lines
# with guessed distances and times, which is easy to miss.
ORS_API_KEY=

# Optional third event source. Blank just means that importer sits out.
TICKETMASTER_API_KEY=
