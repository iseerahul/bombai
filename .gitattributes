# Line endings that survive a Windows checkout.
#
# This repo is developed on Windows and deployed to Linux containers. Git
# stores LF, but a Windows working copy gets CRLF on checkout — and a shell
# script with CRLF line endings fails inside a container with
# "bad interpreter: /bin/sh^M", which is a genuinely baffling error the first
# time you meet it. These files are read by Linux, so they stay LF everywhere.

*.sh            text eol=lf
*.mjs           text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Caddyfile       text eol=lf
*.template      text eol=lf
_headers        text eol=lf
*.sql           text eol=lf

# Binary: never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.woff2         binary
