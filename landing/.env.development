# Where "Explore Bambai" goes during development.
#
# In production both apps share one Cloudflare origin and the default relative
# "/app/" is correct.
#
# The name matters: a plain `.env` is loaded in EVERY mode, so it would bake
# this localhost URL into the production build — which it did, once. A
# `.env.development` file is only read when Vite runs in development.
VITE_MAP_URL=http://127.0.0.1:5173/app/

# Where the live counts come from during development.
#
# In production the landing and the API share one Cloudflare origin, so the
# default "" (a relative /api/stats) is correct. In development the API is a
# separate worker on :8787.
VITE_API_URL=http://127.0.0.1:8787
