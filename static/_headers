# Origin-wide static-asset headers, copied to dist/_headers by the build.
#
# This file lives at the repo root rather than in `public/` because `public/`
# belongs to the map app, which now builds into dist/app/ — a _headers file
# there would sit at /app/_headers and be ignored entirely. These headers cover
# BOTH halves of the product: the landing at / and the map at /app/.
#
# The meta CSP in index.html is a fallback; this is the one that actually
# protects the deployed site, because a header can enforce things a meta tag
# cannot (frame-ancestors) and it applies before any HTML is parsed.

/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://tiles.openfreemap.org; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://lh3.googleusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src blob:; child-src blob:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Baked POI data is regenerated by a manual pipeline run, so it can cache hard
# but must revalidate — otherwise a data rebuild wouldn't reach existing users.
/app/data/*
  Cache-Control: public, max-age=3600, must-revalidate

# Both apps emit content-hashed filenames, so these can never go stale.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# --- the landing, and only the landing ------------------------------------
#
# It is a prerendered TanStack Start page, and TanStack ships two inline
# <script> tags to hydrate it. Under `script-src 'self'` those are blocked: the
# page still paints, because the HTML is already rendered, but nothing on it
# works — no mobile menu, no mood filter, no save buttons.
#
# So script-src is relaxed here and ONLY here. The map app keeps the strict
# policy above, which matters more: it is the half that holds sessions, photos
# and other people's data.
#
# Google Fonts is the landing's display typeface, loaded from fonts.googleapis
# (the stylesheet) and fonts.gstatic (the font files).
#
# NOTE: this relies on a later, more specific rule overriding the `/*` one for
# the same header name. That cannot be tested without deploying — check the
# response headers on / and /app/ after the first `wrangler deploy`.
/
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'

/index.html
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
