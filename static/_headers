# Origin-wide static-asset headers, copied to dist/_headers by the build.
#
# This file lives at the repo root rather than in `public/` because `public/`
# belongs to the map app, which builds into dist/app/ — a _headers file there
# would sit at /app/_headers and be ignored entirely. These headers cover BOTH
# halves of the product: the landing at / and the map at /app/.
#
# ON THE TWO CSP RULES, AND WHY THIS ORDER.
#
# When a response carries two Content-Security-Policy headers the browser
# enforces the INTERSECTION of them, not the last one. An earlier version had
# it backwards: a strict `script-src 'self'` on /* with a relaxed override on
# /, which intersects back to 'self' and blocks the landing's two inline
# hydration scripts — the exact thing the override existed to allow.
#
# So the broad rule carries the LANDING policy and /app/* adds the strict one.
# Now the intersection works for us:
#
#   /            only /* matches        -> landing policy, inline scripts run
#   /app/…       both match             -> intersection = the strict policy
#   /anything    only /* matches        -> landing policy, and since
#                                          not_found_handling serves the
#                                          landing there, that is correct
#
# The map is the half that holds sessions and photos, and it keeps the strict
# policy. Verify after deploying:  curl -I <url>/  and  curl -I <url>/app/

/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The map: strict. Intersected with the rule above, this is what applies.
/app/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://tiles.openfreemap.org; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://lh3.googleusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src blob:; child-src blob:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'

# Baked POI data is regenerated by a manual pipeline run, so it can cache hard
# but must revalidate — otherwise a data rebuild wouldn't reach existing users.
/app/data/*
  Cache-Control: public, max-age=3600, must-revalidate

# Both apps emit content-hashed filenames, so these can never go stale.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
